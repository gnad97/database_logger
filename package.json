{
  "name": "database-logger",
  "productName": "DatabaseLogger",
  "version": "1.0.0",
  "description": "Electron desktop app to view change logs from MongoDB, PostgreSQL, and MySQL databases.",
  "author": "Dang Tong Hai <gnad.dev97@gmail.com>",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "preinstall": "node scripts/check-install.js",
    "start": "concurrently \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "react-scripts build && electron-builder",
    "eject": "react-scripts eject"
  },
  "engines": {
    "node": "20.20.2",
    "npm": "11.6.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "mongodb": "^3.7.3",
    "mysql2": "^3.14.2",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.merchize.databaselogger",
    "productName": "DatabaseLogger",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/256x256.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DatabaseLogger",
      "installerIcon": "assets/256x256.ico",
      "uninstallerIcon": "assets/256x256.ico",
      "installerHeaderIcon": "assets/256x256.ico"
    }
  }
}
